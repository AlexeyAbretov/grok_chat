# Ключ: https://console.x.ai
XAI_API_KEY=

# Ключ: https://platform.openai.com/api-keys
# Тот же ключ считает эмбеддинги корпуса. Отдельный ключ: EMBED_API_KEY.
# Модель и адрес: EMBED_MODEL=text-embedding-3-small, EMBED_URL=https://api.openai.com/v1/embeddings
OPENAI_API_KEY=

# Реранкер корпуса (Cohere). Без ключа гибрид останавливается на reciprocal rank fusion.
# COHERE_API_KEY=
# RERANK_MODEL=rerank-v3.5
# RERANK_URL=https://api.cohere.com/v2/rerank

# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ключ: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
